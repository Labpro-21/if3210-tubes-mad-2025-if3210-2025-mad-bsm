<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="24dp"
    tools:ignore="MissingDefaultResource">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_streak"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#1E1E1E"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Cover image -->
            <ImageView
                android:id="@+id/cover_streak"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginEnd="16dp"
                android:scaleType="centerCrop"
                android:src="@drawable/cover_streak"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.4"
                app:layout_constraintDimensionRatio="1:1"/>

            <!-- Title -->
            <TextView
                android:id="@+id/text_streak_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="You had a 5-day streak"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginLeft="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/cover_streak"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Subtitle -->
            <TextView
                android:id="@+id/text_streak_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="You played Loose by Daniel Caesar day after day. You were on fire"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/text_streak_title"
                app:layout_constraintStart_toStartOf="@id/text_streak_title"
                app:layout_constraintEnd_toEndOf="@id/text_streak_title"/>

            <!-- Date range -->
            <TextView
                android:id="@+id/text_streak_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mar 21–25, 2025"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/text_streak_subtitle"
                app:layout_constraintStart_toStartOf="@id/text_streak_subtitle"/>

            <!-- Share button -->

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
